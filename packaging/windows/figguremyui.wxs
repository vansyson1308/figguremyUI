<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs" xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <?ifndef HasCraftFontLicences ?>
  <?define HasCraftFontLicences=0 ?>
  <?endif?>
  <Package Name="Figgure My UI" Manufacturer="Figgure My UI contributors" Version="$(var.Version)" UpgradeCode="F23971AA-06D4-4B7C-8A67-8A3C42871436" Scope="perUserOrMachine" Compressed="yes" Language="1033">
    <SummaryInformation Description="Figgure My UI interface design and prototyping tool" Manufacturer="Figgure My UI contributors" />
    <?include $(sys.SOURCEFILEDIR)install-policy.wxi?>
    <!-- Same-version upgrades let successive pre-releases of one X.Y.Z replace each other
         (MSI versions are numeric, so 1.2.3-rc.1 and 1.2.3-rc.2 are both 1.2.3). -->
    <MajorUpgrade AllowSameVersionUpgrades="yes" DowngradeErrorMessage="A newer version of Figgure My UI is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <!-- MSI caches this icon using its Id as the filename. Advertised shortcuts to an
         .exe need an .exe icon identifier (ICE50), even when the source is an ICO. -->
    <Icon Id="AppIcon.exe" SourceFile="$(var.IconPath)" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon.exe" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/vansyson1308/figguremyUI" />
    <Property Id="ARPURLUPDATEINFO" Value="https://github.com/vansyson1308/figguremyUI" />
    <Property Id="ARPHELPLINK" Value="https://github.com/vansyson1308/figguremyUI/issues" />

    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="CraftSuiteFolder" Name="ArtCraft">
        <Directory Id="INSTALLFOLDER" Name="Figgure My UI" />
      </Directory>
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder" />

    <!-- An upgrade installs where the user put the previous version (written by AppMain). -->

    <Feature Id="Main" Title="Figgure My UI" Level="1">
      <?if $(var.HasCraftFontLicences) = 1 ?>
      <ComponentGroupRef Id="CraftFontLicences" />
      <?endif?>
      <ComponentGroupRef Id="AppFiles" />
    </Feature>

    <!-- The setup wizard: WixUI_InstallDir without its licence page (the code is MIT OR
         Apache-2.0; there is nothing to accept). A later NewDialog on the same button wins. -->
    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />
    <UI>
      <Publish Dialog="WelcomeDlg" Control="Next" Event="NewDialog" Value="InstallDirDlg" Order="2" Condition="NOT Installed" />
      <Publish Dialog="InstallDirDlg" Control="Back" Event="NewDialog" Value="WelcomeDlg" Order="2" />
      <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction" Value="LaunchApp" Condition="WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 AND NOT Installed" />
    </UI>
    <!-- Our own art, generated by package.ps1 from the app icon (not WiX's stock bitmaps). -->
    <WixVariable Id="WixUIBannerBmp" Value="$(var.BannerBmp)" />
    <WixVariable Id="WixUIDialogBmp" Value="$(var.DialogBmp)" />

    <!-- The full version (Version is numeric, so it drops a pre-release tag), shown on the wizard's
         pages through figguremyui.en-us.wxl. -->
    <Property Id="AppDisplayVersion" Value="$(var.DisplayVersion)" />

    <!-- Finish page: say where to find the app, and offer to start it (ticked by default). -->
    <Property Id="WIXUI_EXITDIALOGOPTIONALTEXT" Value="Figgure My UI $(var.DisplayVersion) is installed. You can start it any time from the Start menu." />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="Launch Figgure My UI" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />
    <Property Id="WixShellExecTarget" Value="[#AppExe]" />
    <!-- Runs in the wizard's own (unelevated) process, so the app starts as the user, not as admin. -->
    <CustomAction Id="LaunchApp" BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)" DllEntry="WixShellExec" Impersonate="yes" Return="ignore" />
  </Package>

  <Fragment>
    <?if $(var.HasCraftFontLicences) = 1 ?>
    <ComponentGroup Id="CraftFontLicences" Directory="INSTALLFOLDER">
      <Files Include="$(var.DocsDir)\**" />
    </ComponentGroup>
    <?endif?>
    <ComponentGroup Id="AppFiles" Directory="INSTALLFOLDER">
      <Component Id="AppMain" Guid="8A3C6107-628E-4FD8-B924-86E90445742D">
        <File Id="AppNotice" Source="$(var.BinDir)\NOTICE" KeyPath="no" />
        <File Id="AppExe" Source="$(var.BinDir)\figguremyui.exe" KeyPath="yes">
          <Shortcut Id="StartMenuShortcut" Directory="ProgramMenuFolder" Name="Figgure My UI" Description="Figgure My UI interface design and prototyping" WorkingDirectory="INSTALLFOLDER" Advertise="yes" Icon="AppIcon.exe" IconIndex="0" />
        </File>

        <!-- .figcraft: Figgure My UI's own format; Figgure My UI is its default app. -->
        <ProgId Id="FiggureMyUI.Document" Description="Figgure My UI Document" Icon="AppExe" IconIndex="0">
          <Extension Id="figcraft" ContentType="application/x-figcraft">
            <Verb Id="open" Command="Open" TargetFile="AppExe" Argument="&quot;%1&quot;" />
          </Extension>
        </ProgId>
        <!-- SVG and images: offered under "Open with", never forced as the default. -->
        <ProgId Id="FiggureMyUI.Image" Description="Image" Icon="AppExe" IconIndex="0" />
        <RegistryValue Root="HKMU" Key="Software\Classes\FiggureMyUI.Image\shell\open\command" Value="&quot;[#AppExe]&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\.svg\OpenWithProgids" Name="FiggureMyUI.Image" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\.png\OpenWithProgids" Name="FiggureMyUI.Image" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\.jpg\OpenWithProgids" Name="FiggureMyUI.Image" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\.jpeg\OpenWithProgids" Name="FiggureMyUI.Image" Value="" Type="string" />
        <!-- Sketch files (opened as a copy; Figgure My UI doesn't save .sketch): "Open with" only too. -->
        <ProgId Id="FiggureMyUI.Sketch" Description="Sketch Document" Icon="AppExe" IconIndex="0" />
        <RegistryValue Root="HKMU" Key="Software\Classes\FiggureMyUI.Sketch\shell\open\command" Value="&quot;[#AppExe]&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\.sketch\OpenWithProgids" Name="FiggureMyUI.Sketch" Value="" Type="string" />

        <!-- "Open with" app list and the Run dialog (Win+R "figguremyui"). -->
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\figguremyui.exe" Name="FriendlyAppName" Value="Figgure My UI" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\figguremyui.exe\shell\open\command" Value="&quot;[#AppExe]&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\figguremyui.exe\SupportedTypes" Name=".figcraft" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\figguremyui.exe\SupportedTypes" Name=".svg" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\figguremyui.exe\SupportedTypes" Name=".png" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\figguremyui.exe\SupportedTypes" Name=".jpg" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\figguremyui.exe\SupportedTypes" Name=".jpeg" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\figguremyui.exe\SupportedTypes" Name=".sketch" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Microsoft\Windows\CurrentVersion\App Paths\figguremyui.exe" Value="[#AppExe]" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Figgure My UI" Name="InstallDir" Value="[INSTALLFOLDER]" Type="string" />
      </Component>

<?if $(var.HasCli) = 1 ?>
      <Component Id="AppCli">
        <File Id="CliExe" Source="$(var.BinDir)\figguremyui-cli.exe" KeyPath="yes" />
      </Component>
<?endif?>
    </ComponentGroup>
  </Fragment>
</Wix>
