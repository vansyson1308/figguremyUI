diff --git a/crates/engine/src/modes_cache_tests.rs b/crates/engine/src/modes_cache_tests.rs
new file mode 100644
index 00000000..6b96a897
--- /dev/null
+++ b/crates/engine/src/modes_cache_tests.rs
@@ -0,0 +1,87 @@
+//! Shortcuts for the prototype simulator and for an agent's commands (performance budgets PF1 and
+//! PF2) answer as what they replace: `ModesCache` as `Document::modes_for` on every layer, and
+//! `changed_nodes` as a lookup of every layer in the version before.
+
+use std::sync::Arc;
+
+use figcraft_doc::{Document, ModesCache, NodeId};
+use serde_json::json;
+
+use crate::Session;
+use crate::synthetic_ds::{DsSpec, design_system_with_instances};
+
+/// A design system with light and dark screens and instances nested inside instances.
+fn themed() -> Document {
+    design_system_with_instances(&DsSpec::SMALL, 40).unwrap().0
+}
+
+#[test]
+fn the_modes_cache_answers_as_modes_for_on_every_layer() {
+    let doc = themed();
+    let ids: Vec<NodeId> = doc.ids().collect();
+    let mut cache = ModesCache::default();
+    // In id order, then the other way round (other chains are worked out first), then again from
+    // what is cached.
+    for id in ids.iter().chain(ids.iter().rev()).chain(ids.iter()) {
+        assert_eq!(cache.modes_for(&doc, *id), doc.modes_for(*id), "layer {id}");
+    }
+    let themed = ids.iter().filter(|i| !doc.modes_for(**i).is_empty()).count();
+    assert!(themed > ids.len() / 4, "{themed} of {} layers are in a mode", ids.len());
+    // A layer that isn't there has no modes.
+    assert!(cache.modes_for(&doc, NodeId(u64::MAX)).is_empty());
+}
+
+#[test]
+fn a_loop_of_parents_is_answered_as_modes_for_answers_it() {
+    let mut s = Session::new();
+    let outer = NodeId(s.execute("node.create", &json!({"type": "frame", "width": 100, "height": 100})).unwrap()["id"].as_u64().unwrap());
+    let inner = NodeId(s.execute("node.create", &json!({"type": "frame", "parent": outer.0, "width": 50, "height": 50})).unwrap()["id"].as_u64().unwrap());
+    let leaf = NodeId(s.execute("node.create", &json!({"type": "rectangle", "parent": inner.0, "width": 5, "height": 5})).unwrap()["id"].as_u64().unwrap());
+    let doc = s.doc_mut().unwrap();
+    doc.node_mut(outer).unwrap().var_modes.insert("c:1".into(), "m:1".into());
+    doc.node_mut(inner).unwrap().var_modes.insert("c:2".into(), "m:2".into());
+    let mut cache = ModesCache::default();
+    for id in [leaf, inner, outer] {
+        assert_eq!(cache.modes_for(doc, id), doc.modes_for(id));
+    }
+    assert_eq!(cache.modes_for(doc, leaf).len(), 2);
+    // A broken file: the outer frame inside the leaf.
+    let mut broken = doc.clone();
+    broken.node_mut(outer).unwrap().parent = Some(leaf);
+    let mut cache = ModesCache::default();
+    for id in [leaf, inner, outer] {
+        assert_eq!(cache.modes_for(&broken, id), broken.modes_for(id), "layer {id}");
+    }
+}
+
+/// What `changed_nodes` replaced: every layer of `doc` looked up in `before`.
+fn looked_up(doc: &Document, before: &Document) -> Vec<NodeId> {
+    doc.ids()
+        .filter(|id| match (doc.node_arc(*id), before.node_arc(*id)) {
+            (Some(a), Some(b)) => !Arc::ptr_eq(a, b),
+            _ => true,
+        })
+        .collect()
+}
+
+#[test]
+fn changed_nodes_are_the_layers_whose_copy_changed() {
+    let mut s = Session::with_document(themed());
+    let before = s.doc().unwrap().clone();
+    let ids: Vec<NodeId> = before.ids().collect();
+    assert_eq!(crate::changed_nodes(&before, &before), Vec::<NodeId>::new());
+    s.execute("shape.rectangle", &json!({"x": 0, "y": 0, "width": 4, "height": 4})).unwrap();
+    let doc = s.doc_mut().unwrap();
+    // Edited, removed, and replaced by an equal copy (a new `Arc` with the same content).
+    doc.node_mut(ids[ids.len() / 2]).unwrap().name = "Edited".into();
+    let last = *ids.last().unwrap();
+    let _ = doc.remove(last);
+    let _ = doc.node_mut(ids[3]);
+    let doc = s.doc().unwrap().clone();
+    let changed = crate::changed_nodes(&doc, &before);
+    assert_eq!(changed, looked_up(&doc, &before));
+    assert!(changed.len() >= 3, "{changed:?}");
+    // And the other way round (what was removed is what is new).
+    assert_eq!(crate::changed_nodes(&before, &doc), looked_up(&before, &doc));
+    assert_eq!(crate::changed_nodes(&before, &Document::default()), before.ids().collect::<Vec<_>>());
+}
